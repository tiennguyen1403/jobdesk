# === Copy file này thành .env rồi chỉnh nếu cần: cp .env.example .env ===
# Dùng cho local dev. Đổi mật khẩu nếu bạn expose ra ngoài máy.

# --- Postgres ---
POSTGRES_DB=jobdesk
POSTGRES_USER=jobdesk
POSTGRES_PASSWORD=jobdesk

# --- Backend (FastAPI) ---
# Host 'db' là tên service trong docker-compose
DATABASE_URL=postgresql+psycopg://jobdesk:jobdesk@db:5432/jobdesk
CORS_ORIGINS=http://localhost:5173
APP_NAME=JobDesk API
# Cổng host cho API. Nếu 8000 bị chiếm (vd Docker service khác), đổi sang 8001...
# rồi nhớ đổi VITE_API_BASE bên dưới cho khớp.
API_PORT=8000

# --- Frontend (Vite) ---
# Phải khớp với API_PORT ở trên
VITE_API_BASE=http://localhost:8000

# --- Phase 2: Claude API (điền khi làm CV/proposal AI) ---
# ANTHROPIC_API_KEY=

# --- Phase 3: Upwork OAuth (điền khi được duyệt API key) ---
# UPWORK_CLIENT_ID=
# UPWORK_CLIENT_SECRET=
