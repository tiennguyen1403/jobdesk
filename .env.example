# === Copy this to .env, then adjust if needed:  cp .env.example .env ===
# For local dev. Change the password if you expose it beyond your machine.

# --- Postgres ---
POSTGRES_DB=jobdesk
POSTGRES_USER=jobdesk
POSTGRES_PASSWORD=jobdesk

# --- Backend (FastAPI) ---
# Host 'db' is the docker-compose service name
DATABASE_URL=postgresql+psycopg://jobdesk:jobdesk@db:5432/jobdesk
# Comma-separated allowed origins. https://www.upwork.com lets the capture
# bookmarklet (docs/capture-bookmarklet.md) POST a scraped job from an Upwork page.
CORS_ORIGINS=http://localhost:5173,https://www.upwork.com
APP_NAME=JobDesk API
# Host port for the API. If 8000 is taken (e.g. another Docker service), change it
# and keep VITE_API_BASE below in sync.
API_PORT=8000

# --- Frontend (Vite) ---
# Must match API_PORT above
VITE_API_BASE=http://localhost:8000
# Public URL of the SPA. The Upwork OAuth callback redirects the browser back here
# (to /sources) after granting, so the user lands in the app, not on a JSON page.
# Keep the host+port in sync with the web dev server, exactly as API_PORT and
# VITE_API_BASE are kept in sync.
WEB_BASE_URL=http://localhost:5173

# --- Phase 2: Claude API (fill in when building the CV/proposal AI) ---
# ANTHROPIC_API_KEY=
# Optional overrides (sensible defaults live in app/config.py):
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_MAX_TOKENS=4096

# --- Phase 3: Upwork OAuth (fill in once the API key is approved) ---
# Create an app at https://www.upwork.com/developer/keys/ and register the
# redirect URI below EXACTLY. Tokens are stored only in the local DB, never logged.
# With these unset, the /api/upwork/* endpoints return a clean 503 (integration off).
# UPWORK_CLIENT_ID=
# UPWORK_CLIENT_SECRET=
# OAuth2 callback URL — must match what you registered on Upwork AND your API_PORT.
# Default matches API_PORT=8000; this machine uses 8001, so set it accordingly:
# UPWORK_REDIRECT_URI=http://localhost:8000/api/upwork/callback
# Optional OAuth2 scopes (space-separated). Upwork grants app-configured
# permissions, so this is normally left empty.
# UPWORK_SCOPE=

# --- Phase 4: Freelancer.com OAuth (fill in once you have a developer app) ---
# Create an app at https://developers.freelancer.com/ and register the redirect
# URI below EXACTLY. Freelancer splits OAuth across two hosts (authorize on
# www.freelancer.com, token on accounts.freelancer.com) — the app handles both.
# Tokens are stored only in the local DB, never logged. With these unset, the
# /api/freelancer/* endpoints return a clean 503 (integration off).
# FREELANCER_CLIENT_ID=
# FREELANCER_CLIENT_SECRET=
# OAuth2 callback URL — must match what you registered on Freelancer AND your
# API_PORT. Default matches API_PORT=8000; this machine uses 8001, so set it:
# FREELANCER_REDIRECT_URI=http://localhost:8000/api/freelancer/callback
# OAuth2 scopes (space-separated). 'basic' is the minimal read scope and the
# default; widen it only if the provider needs more.
# FREELANCER_SCOPE=basic

# --- Phase 3: polling scheduler (in-process, no separate worker) ---
# When enabled, the api container polls every enabled saved search on an interval
# and ingests the results into the Inbox (never auto-applies). Off by default:
# with no stored Upwork token each cycle is a logged no-op, and you can always
# trigger one run by hand via POST /api/saved-searches/{id}/run. Turn it on once
# the Upwork account is connected.
# POLL_ENABLED=false
# Minutes between poll cycles (>= 1).
# POLL_INTERVAL_MINUTES=15
