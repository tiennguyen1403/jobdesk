# === Copy this to .env, then adjust if needed:  cp .env.example .env ===
# For local dev. Change the password if you expose it beyond your machine.

# --- Postgres ---
POSTGRES_DB=jobdesk
POSTGRES_USER=jobdesk
POSTGRES_PASSWORD=jobdesk

# --- Backend (FastAPI) ---
# Host 'db' is the docker-compose service name
DATABASE_URL=postgresql+psycopg://jobdesk:jobdesk@db:5432/jobdesk
CORS_ORIGINS=http://localhost:5173
APP_NAME=JobDesk API
# Host port for the API. If 8000 is taken (e.g. another Docker service), change it
# and keep VITE_API_BASE below in sync.
API_PORT=8000

# --- Frontend (Vite) ---
# Must match API_PORT above
VITE_API_BASE=http://localhost:8000

# --- Phase 2: Claude API (fill in when building the CV/proposal AI) ---
# ANTHROPIC_API_KEY=
# Optional overrides (sensible defaults live in app/config.py):
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_MAX_TOKENS=4096

# --- Phase 3: Upwork OAuth (fill in once the API key is approved) ---
# Create an app at https://www.upwork.com/developer/keys/ and register the
# redirect URI below EXACTLY. Tokens are stored only in the local DB, never logged.
# With these unset, the /api/upwork/* endpoints return a clean 503 (integration off).
# UPWORK_CLIENT_ID=
# UPWORK_CLIENT_SECRET=
# OAuth2 callback URL — must match what you registered on Upwork AND your API_PORT.
# Default matches API_PORT=8000; this machine uses 8001, so set it accordingly:
# UPWORK_REDIRECT_URI=http://localhost:8000/api/upwork/callback
# Optional OAuth2 scopes (space-separated). Upwork grants app-configured
# permissions, so this is normally left empty.
# UPWORK_SCOPE=
